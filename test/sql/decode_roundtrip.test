# name: test/sql/decode_roundtrip.test
# description: Preserve coordinate types and bits when decoding encoded keys
# group: [lindel]

require lindel

foreach curve hilbert morton

# One-dimensional TINYINT: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::TINYINT[1] AS a FROM (VALUES ('-128'), ('-1'), ('0'), ('1'), ('127')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, false) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::UTINYINT, 1, false, false) IS NULL
FROM roundtrips;
----
TINYINT[1]	TINYINT[1]	true	true

# One-dimensional SMALLINT: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::SMALLINT[1] AS a FROM (VALUES ('-32768'), ('-1'), ('0'), ('1'), ('32767')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, false) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::USMALLINT, 1, false, false) IS NULL
FROM roundtrips;
----
SMALLINT[1]	SMALLINT[1]	true	true

# One-dimensional INTEGER: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::INTEGER[1] AS a FROM (VALUES ('-2147483648'), ('-1'), ('0'), ('1'), ('2147483647')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, false) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::UINTEGER, 1, false, false) IS NULL
FROM roundtrips;
----
INTEGER[1]	INTEGER[1]	true	true

# One-dimensional BIGINT: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::BIGINT[1] AS a FROM (VALUES ('-9223372036854775808'), ('-1'), ('0'), ('1'), ('9223372036854775807')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, false) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::UBIGINT, 1, false, false) IS NULL
FROM roundtrips;
----
BIGINT[1]	BIGINT[1]	true	true

# One-dimensional UTINYINT: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::UTINYINT[1] AS a FROM (VALUES ('0'), ('1'), ('255')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, true) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::UTINYINT, 1, false, true) IS NULL
FROM roundtrips;
----
UTINYINT[1]	UTINYINT[1]	true	true

# One-dimensional USMALLINT: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::USMALLINT[1] AS a FROM (VALUES ('0'), ('1'), ('65535')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, true) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::USMALLINT, 1, false, true) IS NULL
FROM roundtrips;
----
USMALLINT[1]	USMALLINT[1]	true	true

# One-dimensional UINTEGER: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::UINTEGER[1] AS a FROM (VALUES ('0'), ('1'), ('4294967295')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, true) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::UINTEGER, 1, false, true) IS NULL
FROM roundtrips;
----
UINTEGER[1]	UINTEGER[1]	true	true

# One-dimensional UBIGINT: boundaries, zero, and NULL.
query TTII
WITH inputs AS (SELECT [v]::UBIGINT[1] AS a FROM (VALUES ('0'), ('1'), ('18446744073709551615')) t(v)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), 1, false, true) AS b FROM inputs)
SELECT typeof(first(b)), typeof(first(a)), bool_and(a = b),
       ${curve}_decode(NULL::UBIGINT, 1, false, true) IS NULL
FROM roundtrips;
----
UBIGINT[1]	UBIGINT[1]	true	true

# One-dimensional FLOAT: signed zero, fractions, infinities and NaN.
query TII
WITH inputs AS (SELECT [v]::FLOAT[1] AS a FROM (VALUES ('-inf'), ('-1.5'), ('-0.0'), ('0.0'), ('1.5'), ('inf'), ('nan')) t(v)),
roundtrips AS (SELECT a, ${curve}_encode(a) AS k, ${curve}_decode(${curve}_encode(a), 1, true, false) AS b FROM inputs)
SELECT typeof(first(b)), bool_and(a = b), bool_and(${curve}_encode(b) = k) FROM roundtrips;
----
FLOAT[1]	true	true

# One-dimensional DOUBLE: signed zero, fractions, infinities and NaN.
query TII
WITH inputs AS (SELECT [v]::DOUBLE[1] AS a FROM (VALUES ('-inf'), ('-1.5'), ('-0.0'), ('0.0'), ('1.5'), ('inf'), ('nan')) t(v)),
roundtrips AS (SELECT a, ${curve}_encode(a) AS k, ${curve}_decode(${curve}_encode(a), 1, true, false) AS b FROM inputs)
SELECT typeof(first(b)), bool_and(a = b), bool_and(${curve}_encode(b) = k) FROM roundtrips;
----
DOUBLE[1]	true	true

# The unsigned flag does not change a floating-point result.
query I
SELECT ${curve}_decode(${curve}_encode([-1.5]::FLOAT[1]), 1, true, true) = [-1.5]::FLOAT[1];
----
true

# Four byte-sized coordinates produce a UINTEGER key.
foreach type TINYINT UTINYINT

query I
SELECT ${curve}_decode(${curve}_encode([1, 2, 3, 4]::${type}[4]), 4, false, false) = [1, 2, 3, 4]::TINYINT[4];
----
true

endloop

# A 32-bit key contains only one FLOAT, regardless of the requested part count.
statement error
SELECT ${curve}_decode(0::UINTEGER, 2, true, false);
----
Expected 1 part for UINTEGER when returning floats

statement error
SELECT ${curve}_decode(0::UHUGEINT, 1, false, false);
----
Expected 2-16 parts for UHUGEINT

statement error
SELECT ${curve}_decode(0::UTINYINT, 0, false, false);
----
Number of parts to return must be greater than 0.

# Exercise every supported dimension across multiple execution vectors.
loop dimensions 1 17

query II
WITH coordinates AS (SELECT list_transform(range(${dimensions}), x -> (i + x) % 127 - 63)::TINYINT[${dimensions}] AS a FROM range(4097) t(i)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), ${dimensions}, false, false) AS b FROM coordinates)
SELECT bool_and(a = b), typeof(first(a)) = typeof(first(b)) FROM roundtrips;
----
true	true

endloop

loop dimensions 1 17

query II
WITH coordinates AS (SELECT list_transform(range(${dimensions}), x -> (i + x) % 127)::UTINYINT[${dimensions}] AS a FROM range(4097) t(i)),
roundtrips AS (SELECT a, ${curve}_decode(${curve}_encode(a), ${dimensions}, false, true) AS b FROM coordinates)
SELECT bool_and(a = b), typeof(first(a)) = typeof(first(b)) FROM roundtrips;
----
true	true

endloop

